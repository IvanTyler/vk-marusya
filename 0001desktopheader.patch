From 891f1be0b5c0d6a5872d9c814573c848bf442198 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 19:07:39 +0000
Subject: [PATCH] Extract SearchInput and drop redundant wrapper in Header

Pass the grid classes straight into ContainerSection's className
instead of an extra wrapping div, and move the search field markup
into its own reusable SearchInput component.
---
 src/Components/UI/Header/Header.module.scss   | 17 -------------
 src/Components/UI/Header/Header.tsx           | 25 +++++++------------
 .../UI/SearchInput/SearchInput.module.scss    | 16 ++++++++++++
 src/Components/UI/SearchInput/SearchInput.tsx | 18 +++++++++++++
 4 files changed, 43 insertions(+), 33 deletions(-)
 create mode 100644 src/Components/UI/SearchInput/SearchInput.module.scss
 create mode 100644 src/Components/UI/SearchInput/SearchInput.tsx

diff --git a/src/Components/UI/Header/Header.module.scss b/src/Components/UI/Header/Header.module.scss
index 5fd5746..db0c4c2 100644
--- a/src/Components/UI/Header/Header.module.scss
+++ b/src/Components/UI/Header/Header.module.scss
@@ -18,23 +18,6 @@
     column-gap: 40px;
 }
 
-.search {
-    position: relative;
-    display: flex;
-    align-items: center;
-}
-
-.searchIcon {
-    position: absolute;
-    left: 16px;
-    color: var(--content-disabled);
-    pointer-events: none;
-}
-
-.searchInput {
-    padding-left: 52px;
-}
-
 .login {
     white-space: nowrap;
 }
diff --git a/src/Components/UI/Header/Header.tsx b/src/Components/UI/Header/Header.tsx
index c418942..b67fa15 100644
--- a/src/Components/UI/Header/Header.tsx
+++ b/src/Components/UI/Header/Header.tsx
@@ -2,29 +2,22 @@ import { FC } from 'react';
 import { ContainerSection } from '@/Components/UI/ContainerSection/ContainerSection';
 import { Logo } from '@/Components/UI/Logo/Logo';
 import { MenuItem } from '@/Components/UI/MenuItem/MenuItem';
-import { Input } from '@/Components/UI/Input/Input';
-import { Icon } from '@/Components/UI/Icon/Icon';
+import { SearchInput } from '@/Components/UI/SearchInput/SearchInput';
 import style from './Header.module.scss';
 
 export const Header: FC = () => {
     return (
         <header className={style.header}>
-            <ContainerSection>
-                <div className={style.wrapper}>
-                    <Logo />
+            <ContainerSection className={style.wrapper}>
+                <Logo />
 
-                    <nav className={style.nav}>
-                        <MenuItem active>Главная</MenuItem>
-                        <MenuItem>Жанры</MenuItem>
+                <nav className={style.nav}>
+                    <MenuItem active>Главная</MenuItem>
+                    <MenuItem>Жанры</MenuItem>
+                    <SearchInput placeholder="Поиск" />
+                </nav>
 
-                        <label className={style.search}>
-                            <Icon name="search" className={style.searchIcon} />
-                            <Input placeholder="Поиск" className={style.searchInput} />
-                        </label>
-                    </nav>
-
-                    <MenuItem className={style.login}>Войти</MenuItem>
-                </div>
+                <MenuItem className={style.login}>Войти</MenuItem>
             </ContainerSection>
         </header>
     );
diff --git a/src/Components/UI/SearchInput/SearchInput.module.scss b/src/Components/UI/SearchInput/SearchInput.module.scss
new file mode 100644
index 0000000..acc0499
--- /dev/null
+++ b/src/Components/UI/SearchInput/SearchInput.module.scss
@@ -0,0 +1,16 @@
+.search {
+    position: relative;
+    display: flex;
+    align-items: center;
+}
+
+.icon {
+    position: absolute;
+    left: 16px;
+    color: var(--content-disabled);
+    pointer-events: none;
+}
+
+.input {
+    padding-left: 52px;
+}
diff --git a/src/Components/UI/SearchInput/SearchInput.tsx b/src/Components/UI/SearchInput/SearchInput.tsx
new file mode 100644
index 0000000..d1abab4
--- /dev/null
+++ b/src/Components/UI/SearchInput/SearchInput.tsx
@@ -0,0 +1,18 @@
+import { FC, InputHTMLAttributes } from 'react';
+import clsx from 'clsx';
+import { Icon } from '@/Components/UI/Icon/Icon';
+import { Input } from '@/Components/UI/Input/Input';
+import style from './SearchInput.module.scss';
+
+interface SearchInputProps extends InputHTMLAttributes<HTMLInputElement> {
+    className?: string;
+}
+
+export const SearchInput: FC<SearchInputProps> = ({ className, ...restProps }) => {
+    return (
+        <label className={clsx(style.search, className)}>
+            <Icon name="search" className={style.icon} />
+            <Input className={style.input} {...restProps} />
+        </label>
+    );
+};
-- 
